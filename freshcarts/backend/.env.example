# ---------------------------------------------------------------------------
# FreshCarts API — environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# Catalogue scope - which store the customer catalogue is served from.
# Leave blank to fall back to the oldest active store in the database.
DEFAULT_STORE_SLUG=freshcarts-gulberg

# Store-local time, as minutes ahead of UTC. Used to decide whether the store is
# open and can accept an order. 300 = PKT (+05:00), which has no DST.
STORE_TIMEZONE_OFFSET_MINUTES=300

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/freshcarts

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# Password hashing
BCRYPT_SALT_ROUNDS=12

# CORS — comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Refresh-token cookie
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Rate limiting (global default)
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# ---------------------------------------------------------------------------
# Routing — how road distance to a delivery address is measured
#
#   estimate : straight-line distance x ROUTING_ESTIMATE_ROAD_FACTOR.
#              Development only. The application REFUSES TO BOOT in production
#              with this set, because an approximated distance would produce a
#              real delivery charge.
#   osrm     : an OSRM-compatible routing service. Self-hostable, no API key.
#              ROUTING_OSRM_BASE_URL is then required.
# ---------------------------------------------------------------------------
ROUTING_PROVIDER=estimate
ROUTING_OSRM_BASE_URL=
ROUTING_TIMEOUT_MS=4000
ROUTING_ESTIMATE_ROAD_FACTOR=1.35
ROUTING_ESTIMATE_SPEED_KPH=22

# Delivery service area. Beyond this the shopper is offered pickup instead.
# Distance bands and their fees are configured per store in the database
# (delivery_pricing_rules) and seeded by `npm run seed`.
DELIVERY_MAX_DISTANCE_METERS=12000

# Customer-facing order numbers: <PREFIX>-<YEAR>-<SEQUENCE>, e.g. FC-2026-0001482
ORDER_NUMBER_PREFIX=FC

# Payment methods the API will accept, comma separated. A method must be BOTH
# listed here AND backed by a registered provider before it is offered to a
# shopper — adding one to the enum is not enough.
PAYMENT_METHODS_ENABLED=CASH_ON_DELIVERY

# How long a completed order-creation idempotency key stays replayable (seconds).
IDEMPOTENCY_TTL_SECONDS=86400

# ---------------------------------------------------------------------------
# AI service - the Python/FastAPI OCR service behind "Scan Grocery List"
#
# FreshCarts works completely without it: browsing, search, cart and checkout
# are unaffected when it is down, and only the scanner degrades. The frontend
# asks GET /ocr/availability before offering the feature at all.
#
# In production this MUST be a private address. The service performs no
# authentication of its own - it trusts that only the FreshCarts API can reach
# it - so exposing it publicly would expose an unauthenticated OCR endpoint.
# ---------------------------------------------------------------------------
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_ENABLED=true

# Hard ceiling on one OCR call. OCR on a phone photo takes seconds, not
# milliseconds, so this is generous - but never unbounded.
AI_SERVICE_TIMEOUT_MS=25000

# Retries for a request that never reached the service. ONLY connection
# failures are retried; a timeout never is, because the image was received and
# retrying would run the expensive step twice.
AI_SERVICE_CONNECT_RETRIES=1

# Grocery-list scanning limits. A scan uploads megabytes and occupies an OCR
# engine for seconds, so it gets its own per-shopper allowance rather than
# sharing the global request throttle.
SCAN_MAX_IMAGE_BYTES=8388608
SCAN_RATE_LIMIT=10
SCAN_RATE_LIMIT_TTL_MS=300000

# Development seed accounts (seed script only — never used in production)
SEED_ADMIN_PHONE=+923001234567
SEED_ADMIN_PASSWORD=Admin@12345
SEED_MANAGER_PHONE=+923001234568
SEED_MANAGER_PASSWORD=Manager@12345
SEED_CUSTOMER_PHONE=+923001234569
SEED_CUSTOMER_PASSWORD=Customer@12345
