# ---------------------------------------------------------------------------
# FreshCarts API — environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# Catalogue scope - which store the customer catalogue is served from.
# Leave blank to fall back to the oldest active store in the database.
DEFAULT_STORE_SLUG=freshcarts-gulberg

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/freshcarts

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# Password hashing
BCRYPT_SALT_ROUNDS=12

# CORS — comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Refresh-token cookie
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Rate limiting (global default)
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# Development seed accounts (seed script only — never used in production)
SEED_ADMIN_PHONE=+923001234567
SEED_ADMIN_PASSWORD=Admin@12345
SEED_MANAGER_PHONE=+923001234568
SEED_MANAGER_PASSWORD=Manager@12345
SEED_CUSTOMER_PHONE=+923001234569
SEED_CUSTOMER_PASSWORD=Customer@12345
