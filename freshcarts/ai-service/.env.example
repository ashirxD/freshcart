# ---------------------------------------------------------------------------
# FreshCarts AI service — environment configuration
#
# Copy to `.env` and adjust. Every variable is prefixed AI_ and read only by
# app/core/config.py.
#
# This service holds no secrets: no database URI, no JWT key, no payment
# credential. It receives an image and returns structured text, and it is
# deliberately incapable of anything else.
# ---------------------------------------------------------------------------

AI_ENVIRONMENT=development
AI_HOST=127.0.0.1
AI_PORT=8000
AI_LOG_LEVEL=INFO

# --- OCR engine ------------------------------------------------------------
# Which implementation of OcrProvider reads the image. Adding an engine means
# adding a class and a name in app/ocr/registry.py; nothing else changes, and
# NestJS never learns which one is running.
AI_OCR_PROVIDER=tesseract

# Absolute path to the Tesseract binary. Leave blank when it is on PATH.
# Windows (UB Mannheim build) is typically:
#   C:\Program Files\Tesseract-OCR\tesseract.exe
AI_TESSERACT_CMD=

# Language packs, in preference order. `urd` is what makes an Urdu-script list
# readable at all — without it such a list comes back as noise, and the service
# says so in `warnings` rather than pretending it read something.
# A missing pack degrades to English; it does not fail the request.
AI_TESSERACT_LANGUAGES=eng+urd

# Directory holding the .traineddata language models.
#
# Worth setting rather than relying on Tesseract's own: the Windows and Debian
# installers ship English ONLY, and adding a language to their install
# directory requires administrator rights. Populate this with:
#
#   python scripts/fetch_tessdata.py
#
# Leave blank to use whatever the system install provides.
AI_TESSERACT_DATA_PATH=

# Page segmentation mode. 6 = "a single uniform block of text", which is what a
# grocery list is. The default (3) hunts for columns and headers it does not have.
AI_TESSERACT_PSM=6

# Hard ceiling on one OCR run. Must be comfortably below the NestJS
# AI_SERVICE_TIMEOUT_MS, so this service reports a timeout rather than being cut off.
AI_OCR_TIMEOUT_SECONDS=20

# --- Image limits ----------------------------------------------------------
# Mirrors SCAN_MAX_IMAGE_BYTES in the API, which rejects an oversized upload
# before it ever reaches this service. Enforced again here because "the caller
# checked" is not a security control.
AI_MAX_IMAGE_BYTES=8388608

# Below this an image cannot hold legible handwriting, and the honest answer is
# "take a clearer photo" rather than an empty result.
AI_MIN_IMAGE_DIMENSION=80

# Decompression-bomb guard: a small file that expands into an enormous bitmap.
AI_MAX_IMAGE_PIXELS=40000000

# Images larger than this on the long edge are downscaled before OCR. Past
# roughly this width Tesseract gets slower without getting better.
AI_OCR_TARGET_LONG_EDGE=2000

# --- Extraction limits -----------------------------------------------------
AI_MAX_ITEMS=60
AI_MIN_LINE_LENGTH=2
