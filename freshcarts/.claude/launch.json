{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "freshcarts-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "freshcarts-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "backend",
        "run",
        "start:dev"
      ],
      "port": 4000
    }
  ]
}
